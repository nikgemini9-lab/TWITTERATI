# ─── Rettiwt Authentication ───────────────────────────────────────────────────
# Get your API key using the browser extension:
#   Chrome : https://chromewebstore.google.com/detail/x-auth-helper/nodmfpnkkmpnaocflfhgkemlnfkipfkc
#   Firefox: Search "Rettiwt Auth Helper" on addons.mozilla.org
#
# Steps:
#   1. Install the extension
#   2. Open an incognito / private window and log in to x.com
#   3. Click the extension icon → "Get Key"
#   4. Paste the base64 key below
#
# The key stays valid for ~5 years (until you log out or change your password).
# Without a key the app falls back to guest mode (no viewCount, stricter limits).
RETTIWT_API_KEY=your_rettiwt_api_key_here

# ─── Database ─────────────────────────────────────────────────────────────────
# Render provides this automatically when you attach a PostgreSQL instance.
# For local dev: postgresql://user:password@localhost:5432/twitterati
DATABASE_URL=postgresql://user:password@localhost:5432/twitterati

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Search tuning (optional) ─────────────────────────────────────────────────
# Minimum likes threshold for a tweet to be tracked. Default: 15000
MIN_LIKES=15000

# How far back to search for tweets (hours). Default: 48
HOURS_BACK=48

# Maximum search result pages per fetch run (20 tweets/page). Default: 3
MAX_PAGES=3

# Delay between API requests in milliseconds. Default: 2000
REQUEST_DELAY_MS=2000

# Set to "true" to enable Rettiwt HTTP debug logs
RETTIWT_LOGGING=false
