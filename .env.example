# ─── X / Twitter API ──────────────────────────────────────────────────────────
# Required. Get this from https://developer.x.com/en/portal/dashboard
# You need Elevated (or higher) access for the min_faves: search operator.
TWITTER_BEARER_TOKEN=your_bearer_token_here

# ─── Database ─────────────────────────────────────────────────────────────────
# Render provides this automatically when you attach a PostgreSQL instance.
# For local dev: postgresql://user:password@localhost:5432/twitterati
DATABASE_URL=postgresql://user:password@localhost:5432/twitterati

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Search tuning (optional) ─────────────────────────────────────────────────
# The search query sent to the X API. Requires Elevated access for min_faves:.
SEARCH_QUERY=min_faves:15000 -is:retweet

# How far back to search for tweets (hours). Default: 48
HOURS_BACK=48
