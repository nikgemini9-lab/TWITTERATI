TWITTER_COOKIE=your_twitter_auth_token_cookie_here

# Turso — free tier at https://app.turso.tech (no credit card needed, no expiry)
TURSO_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
# Groq — free tier at https://console.groq.com (no credit card needed)
GROQ_API_KEY=your_groq_api_key_here
# Optional: swap to smarter but slower model
# GROQ_MODEL=llama-3.3-70b-versatile

PORT=3001
MIN_LIKES=20
